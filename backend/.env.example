# ═══════════════════════════════════════════════════════════════════
#  TUTOIA · variables de entorno del backend
#  Copia este archivo como .env y ajústalo.
# ═══════════════════════════════════════════════════════════════════

# Motor de análisis:
#   mock = motor heurístico local (sin API key ni internet). Ideal para
#          desarrollo y para presentaciones a prueba de fallos de red.
#   live = modelo de lenguaje en la nube (juicio semántico completo).
LLM_MODE=mock

# Clave del proveedor (solo necesaria en modo live).
# Compatible con: OpenAI, DeepSeek, Groq, Together, OpenRouter, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
