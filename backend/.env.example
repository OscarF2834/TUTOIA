# ═══════════════════════════════════════════════════════════════════
#  TUTOIA · variables de entorno del backend
#  Copia este archivo como .env y ajústalo.
# ═══════════════════════════════════════════════════════════════════

# Motor de análisis:
#   mock = motor heurístico local (sin API key ni internet). Ideal para
#          desarrollo y para presentaciones a prueba de fallos de red.
#   live = modelo de lenguaje en la nube (juicio semántico completo).
LLM_MODE=mock

# Clave del proveedor (solo necesaria en modo live).
# Compatible con: OpenAI, DeepSeek, Groq, Together, OpenRouter, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ═══════════════════════════════════════════════════════════════════
#  Módulo 1 · Clean Architecture (Ingesta FDC + Gemini + SQLAlchemy)
# ═══════════════════════════════════════════════════════════════════
# Desarrollo local con SQLite; en producción usar PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tutoia
DATABASE_URL=sqlite:///./tutoia_dev.db
DB_AUTO_CREATE=true

# Google Gemini API (SDK oficial google-genai)
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_DIALOG_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BASE_DELAY_SECONDS=1.5
GEMINI_TIMEOUT_SECONDS=45

# Límites de ingesta FDC
FDC_MAX_UPLOAD_MB=20
FDC_MIN_TEXT_CHARS=500
